              <inertial pos="-0.000805 -0.003146 -0.109215" quat="0.940537 0.00388176 -0.00383651 -0.339646" mass="1.5" diaginertia="0.0237114 0.0236423 0.00123733"/>
              <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Right_Shank"/>
              <geom size="0.045 0.035" quat="0.707105 0.707108 0 0" type="cylinder" class="visual" rgba="0.75294 0.75294 0.75294 1"/>
              <geom size="0.03 0.03 0.05" pos="0 0 -0.13" type="box" class="visual" rgba="0.75294 0.75294 0.75294 1"/>
              <body name="Right_Ankle_Cross" pos="0.00019706 -0.0002 -0.24519">
                <joint name="Right_Ankle_Pitch" pos="0 0 0" axis="0 1 0" range="-0.87 0.345"
                       armature="0.0565056" damping="1" frictionloss="0.1" actuatorfrcrange="-36 36"/>
                <inertial pos="0 0 0" quat="0.5 0.5 0.5 0.5" mass="0.039" diaginertia="4e-06 4e-06 2e-06"/>
                <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Right_Ankle_Cross"/>
                <body name="right_foot_link">
                  <joint name="Right_Ankle_Roll" pos="0 0 0" axis="1 0 0" range="-0.345 0.345"
                         armature="0.0565056" damping="1" frictionloss="0.1" actuatorfrcrange="-36 36"/>
                  <site name="r_foot" pos="0.026 0 -0.038"/>
                  <inertial pos="0.011662 -0.000244 -0.014364" quat="0.00144487 0.663983 0.00148176 0.747745" mass="0.494" diaginertia="0.0012267 0.00117 0.000247305"/>
                  <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Right_Foot"/>
                  <geom name="r_foot_collision" class="collision" type="box" pos="0.026 0 -0.02" size="0.09 0.035 0.018" rgba="0.75294 0.75294 0.75294 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- 12 leg actuators only. kp/kv match stiffness/damping specs. -->
  <actuator>
    <position name="Left_Hip_Pitch"   joint="Left_Hip_Pitch"   kp="80" kv="4" forcerange="-40 40"/>
    <position name="Left_Hip_Roll"    joint="Left_Hip_Roll"    kp="80" kv="4" forcerange="-50 50"/>
    <position name="Left_Hip_Yaw"     joint="Left_Hip_Yaw"     kp="80" kv="4" forcerange="-30 30"/>
    <position name="Left_Knee_Pitch"  joint="Left_Knee_Pitch"  kp="80" kv="4" forcerange="-56 56"/>
    <position name="Left_Ankle_Pitch" joint="Left_Ankle_Pitch" kp="50" kv="2" forcerange="-36 36"/>
    <position name="Left_Ankle_Roll"  joint="Left_Ankle_Roll"  kp="60" kv="2" forcerange="-36 36"/>
    <position name="Right_Hip_Pitch"  joint="Right_Hip_Pitch"  kp="80" kv="4" forcerange="-40 40"/>
    <position name="Right_Hip_Roll"   joint="Right_Hip_Roll"   kp="80" kv="4" forcerange="-50 50"/>
    <position name="Right_Hip_Yaw"    joint="Right_Hip_Yaw"    kp="80" kv="4" forcerange="-30 30"/>
    <position name="Right_Knee_Pitch" joint="Right_Knee_Pitch" kp="80" kv="4" forcerange="-56 56"/>
    <position name="Right_Ankle_Pitch" joint="Right_Ankle_Pitch" kp="50" kv="2" forcerange="-36 36"/>
    <position name="Right_Ankle_Roll"  joint="Right_Ankle_Roll"  kp="60" kv="2" forcerange="-36 36"/>
  </actuator>

  <sensor>
    <framequat name="orientation" objtype="site" noise="0.001" objname="imu"/>
    <framepos name="position" objtype="site" noise="0.001" objname="imu"/>
    <gyro site="imu" name="gyro"/>
    <velocimeter site="imu" name="local_linvel"/>
    <accelerometer site="imu" name="accelerometer"/>
    <subtreeangmom name="root_angmom" body="Trunk"/>
    <framezaxis objtype="site" objname="imu" name="upvector"/>
    <framelinvel objtype="site" objname="imu" name="global_linvel"/>
    <frameangvel objtype="site" objname="imu" name="global_angvel"/>
    <framepos name="l_foot_pos" objtype="site" objname="l_foot"/>
    <framepos name="r_foot_pos" objtype="site" objname="r_foot"/>
    <framelinvel name="l_foot_global_linvel" objtype="site" objname="l_foot"/>
    <framelinvel name="r_foot_global_linvel" objtype="site" objname="r_foot"/>
  </sensor>
</mujoco>
