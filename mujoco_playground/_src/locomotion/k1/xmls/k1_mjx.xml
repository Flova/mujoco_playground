<mujoco model="k1">
  <compiler angle="radian" meshdir="meshes/" autolimits="true"/>

  <option iterations="3" ls_iterations="5" timestep="0.002" integrator="Euler">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <geom solimp="0.90 0.95 0.001" solref="0.001 1"/>
    <default class="collision">
      <geom group="3" contype="1" conaffinity="1"/>
    </default>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2" density="0"/>
    </default>
  </default>

  <asset>
    <mesh name="Trunk" file="Trunk.STL"/>
    <mesh name="Head_1" file="Head_1.STL"/>
    <mesh name="Head_2" file="Head_2.STL"/>
    <mesh name="Left_Arm_1" file="Left_Arm_1.STL"/>
    <mesh name="Left_Arm_2" file="Left_Arm_2.STL"/>
    <mesh name="Left_Arm_3" file="Left_Arm_3.STL"/>
    <mesh name="Left_Arm_4" file="Left_Arm_4.STL"/>
    <mesh name="Right_Arm_1" file="Right_Arm_1.STL"/>
    <mesh name="Right_Arm_2" file="Right_Arm_2.STL"/>
    <mesh name="Right_Arm_3" file="Right_Arm_3.STL"/>
    <mesh name="Right_Arm_4" file="Right_Arm_4.STL"/>
    <mesh name="Left_Hip_Pitch" file="Left_Hip_Pitch.STL"/>
    <mesh name="Left_Hip_Roll" file="Left_Hip_Roll.STL"/>
    <mesh name="Left_Hip_Yaw" file="Left_Hip_Yaw.STL"/>
    <mesh name="Left_Shank" file="Left_Shank.STL"/>
    <mesh name="Left_Ankle_Cross" file="Left_Ankle_Cross.STL"/>
    <mesh name="Left_Foot" file="Left_Foot.STL"/>
    <mesh name="Right_Hip_Pitch" file="Right_Hip_Pitch.STL"/>
    <mesh name="Right_Hip_Roll" file="Right_Hip_Roll.STL"/>
    <mesh name="Right_Hip_Yaw" file="Right_Hip_Yaw.STL"/>
    <mesh name="Right_Shank" file="Right_Shank.STL"/>
    <mesh name="Right_Ankle_Cross" file="Right_Ankle_Cross.STL"/>
    <mesh name="Right_Foot" file="Right_Foot.STL"/>
  </asset>

  <worldbody>
    <body name="Trunk" pos="0 0 0.665">
      <joint name="world_joint" type="free" limited="false" actuatorfrclimited="false"/>
      <site name="imu" size="0.01" pos="0.0 0.0 0.0"/>
      <camera name="front" pos="1.2 -0.4 0.3" xyaxes="0.34 0.94 0 -0.32 0.12 0.94" mode="trackcom"/>
      <camera name="track" pos="0.8 -1.1 0.2" xyaxes="0.81 0.58 0 -0.14 0.20 0.97" mode="trackcom"/>
      <inertial pos="-0.0043392 -0.00065534 0.065686" quat="0.999896 -0.00411546 0.0137413 -0.00168959" mass="6.5" diaginertia="0.0962166 0.0895166 0.0201248"/>
      <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Trunk"/>
      <geom size="0.06 0.08 0.1" pos="0 0 0.1" type="box" class="visual" rgba="0.75294 0.75294 0.75294 0"/>
      <geom size="0.05 0.05" pos="0 0 -0.06" quat="0.707105 0.707108 0 0" type="cylinder" class="visual" rgba="0.75294 0.75294 0.75294 1"/>

      <!-- Head: rigid (no joints), fixed at zero pose -->
      <body name="Head_1" pos="0.0056 0 0.2149">
        <inertial pos="-0.00069503 -0.00038527 0.031688" quat="0.993827 -0.00957801 0.00894723 -0.110168" mass="0.3" diaginertia="0.000429546 0.000420659 0.000125795"/>
        <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Head_1"/>
        <body name="Head_2" pos="0 0 0.033">
          <inertial pos="0.011042 -0.00092871 0.080698" quat="0.996402 -0.00118413 -0.0779414 -0.0332651" mass="0.7" diaginertia="0.00603249 0.00577511 0.0017024"/>
          <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Head_2"/>
        </body>
      </body>

      <!-- Left arm: rigid, baked at Left_Shoulder_Roll=-1.4, Left_Elbow_Yaw=-0.4 -->
      <body name="Left_Arm_1" pos="0 0.077 0.1845">
        <inertial pos="-0.002701 0.062383 -0.011965" quat="0.578658 0.689818 -0.347436 0.261905" mass="0.5" diaginertia="0.00223871 0.00217107 0.000254225"/>
        <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Left_Arm_1"/>
        <!-- Left_Arm_2: baked Left_Shoulder_Roll=-1.4 (rot around x) -->
        <body name="Left_Arm_2" pos="0.0025 0.068 -0.0135" euler="-1.4 0 0">
          <inertial pos="0.01729 0.018221 -4.329e-05" quat="0.413453 0.573635 -0.413453 0.573635" mass="0.09" diaginertia="0.000113 9.5e-05 6.5e-05"/>
          <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Left_Arm_2"/>
          <geom size="0.035 0.034" pos="-0.007 0 0" quat="0.707105 0 0.707108 0" type="cylinder" class="visual" rgba="0.75294 0.75294 0.75294 1"/>
          <body name="Left_Arm_3" pos="0 0.044428 0">
            <inertial pos="-0.0003979 0.072617 -0.00066218" quat="0.679502 0.689551 0.177403 -0.176989" mass="0.8" diaginertia="0.00606947 0.00606767 0.000385851"/>
            <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Left_Arm_3"/>
            <!-- left_hand_link: baked Left_Elbow_Yaw=-0.4 (rot around z) -->
            <body name="left_hand_link" pos="0 0.1215 0" euler="0 0 -0.4">
              <inertial pos="-0.0015751 0.084637 0.0087033" quat="0.712106 0.700961 0.0264125 -0.0293496" mass="0.19" diaginertia="0.00205619 0.00202933 8.1482e-05"/>
              <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Left_Arm_4"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Right arm: rigid, baked at Right_Shoulder_Roll=1.4, Right_Elbow_Yaw=0.4 -->
      <body name="Right_Arm_1" pos="0 -0.077 0.1845">
        <inertial pos="-0.0026302 -0.06251 -0.01199" quat="0.689302 0.577958 -0.263425 0.348475" mass="0.5" diaginertia="0.00224439 0.00217742 0.000255199"/>
        <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Right_Arm_1"/>
        <!-- Right_Arm_2: baked Right_Shoulder_Roll=1.4 (rot around x) -->
        <body name="Right_Arm_2" pos="0.0025 -0.068 -0.0135" euler="1.4 0 0">
          <inertial pos="0.017229 -0.018428 4.3784e-05" quat="0.573635 0.413453 -0.573635 0.413453" mass="0.09" diaginertia="0.000113 9.5e-05 6.5e-05"/>
          <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Right_Arm_2"/>
          <geom size="0.035 0.034" pos="-0.007 0 0" quat="0.707105 0 0.707108 0" type="cylinder" class="visual" rgba="0.75294 0.75294 0.75294 1"/>
          <body name="Right_Arm_3" pos="0 -0.044428 0">
            <inertial pos="-0.00039919 -0.072601 -0.00065629" quat="0.689551 0.679502 0.176989 -0.177403" mass="0.8" diaginertia="0.00607047 0.00606867 0.000386851"/>
            <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Right_Arm_3"/>
            <!-- right_hand_link: baked Right_Elbow_Yaw=0.4 (rot around z) -->
            <body name="right_hand_link" pos="0 -0.1215 0" euler="0 0 0.4">
              <inertial pos="-0.0015177 -0.084536 0.0086733" quat="0.700925 0.712091 0.0296562 -0.0274245" mass="0.19" diaginertia="0.00205618 0.00203032 8.14943e-05"/>
              <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Right_Arm_4"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Left leg -->
      <body name="Left_Hip_Pitch" pos="0 0.096 -0.077">
        <joint name="Left_Hip_Pitch" pos="0 0 0" axis="0 1 0" range="-3 2.21"
               armature="0.0478125" damping="1" frictionloss="0.2" actuatorfrcrange="-40 40"/>
        <inertial pos="-0.010093 -0.0019934 -0.024713" quat="0.704206 -0.178798 -0.198986 0.65767" mass="0.69" diaginertia="0.000987585 0.000880963 0.000503452"/>
        <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Left_Hip_Pitch"/>
        <body name="Left_Hip_Roll" pos="0 0 -0.026">
          <joint name="Left_Hip_Roll" pos="0 0 0" axis="1 0 0" range="-0.4 1.57"
                 armature="0.0339552" damping="1" frictionloss="0.2" actuatorfrcrange="-50 50"/>
          <inertial pos="0.023585 4.9e-05 -0.024996" quat="0.677218 0.203412 0.203412 0.677218" mass="0.13" diaginertia="0.000262 0.000222694 0.000118306"/>
          <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Left_Hip_Roll"/>
          <geom size="0.036 0.047" quat="0.707105 0 0.707108 0" type="cylinder" class="visual" rgba="0.75294 0.75294 0.75294 1"/>
          <body name="Left_Hip_Yaw" pos="0.012 0 -0.0485">
            <joint name="Left_Hip_Yaw" pos="0 0 0" axis="0 0 1" range="-1 1"
                   armature="0.0282528" damping="1" frictionloss="0.2" actuatorfrcrange="-30 30"/>
            <inertial pos="-0.0084744 -0.0040494 -0.087906" quat="0.857995 -0.00590801 -0.0582713 0.510308" mass="1.65" diaginertia="0.0162716 0.0158564 0.00134895"/>
            <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Left_Hip_Yaw"/>
            <geom size="0.04 0.033" pos="0 0 -0.03" type="cylinder" class="visual" rgba="0.75294 0.75294 0.75294 1"/>
            <body name="Left_Shank" pos="-0.014 0 -0.117">
              <joint name="Left_Knee_Pitch" pos="0 0 0" axis="0 1 0" range="0 2.23"
                     armature="0.095625" damping="1" frictionloss="0.2" actuatorfrcrange="-56 56"/>
              <inertial pos="-0.00081083 0.0031459 -0.10922" quat="0.940563 -0.00388906 -0.00385774 0.339574" mass="1.5" diaginertia="0.0237114 0.0236423 0.00123731"/>
              <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Left_Shank"/>
              <geom size="0.045 0.035" quat="0.707105 0.707108 0 0" type="cylinder" class="visual" rgba="0.75294 0.75294 0.75294 1"/>
              <geom size="0.03 0.03 0.05" pos="0 0 -0.13" type="box" class="visual" rgba="0.75294 0.75294 0.75294 1"/>
              <body name="Left_Ankle_Cross" pos="0.00019706 0.0002 -0.24519">
                <joint name="Left_Ankle_Pitch" pos="0 0 0" axis="0 1 0" range="-0.87 0.345"
                       armature="0.0565056" damping="1" frictionloss="0.1" actuatorfrcrange="-36 36"/>
                <inertial pos="0 0 0" quat="0.5 0.5 0.5 0.5" mass="0.039" diaginertia="4e-06 4e-06 2e-06"/>
                <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Left_Ankle_Cross"/>
                <body name="left_foot_link">
                  <joint name="Left_Ankle_Roll" pos="0 0 0" axis="1 0 0" range="-0.345 0.345"
                         armature="0.0565056" damping="1" frictionloss="0.1" actuatorfrcrange="-36 36"/>
                  <site name="l_foot" pos="0.026 0 -0.038"/>
                  <inertial pos="0.011662 0.000244 -0.014364" quat="-0.00144487 0.663983 -0.00148176 0.747745" mass="0.494" diaginertia="0.0012267 0.00117 0.000247305"/>
                  <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Left_Foot"/>
                  <geom name="l_foot_collision" class="collision" type="box" pos="0.026 0 -0.02" size="0.09 0.035 0.018" rgba="0.75294 0.75294 0.75294 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- Right leg -->
      <body name="Right_Hip_Pitch" pos="0 -0.096 -0.077">
        <joint name="Right_Hip_Pitch" pos="0 0 0" axis="0 1 0" range="-3 2.21"
               armature="0.0478125" damping="1" frictionloss="0.2" actuatorfrcrange="-40 40"/>
        <inertial pos="-0.010065 0.0020086 -0.024739" quat="0.656712 -0.199052 -0.176963 0.705544" mass="0.69" diaginertia="0.000988671 0.000880749 0.00050458"/>
        <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Right_Hip_Pitch"/>
        <body name="Right_Hip_Roll" pos="0 0 -0.026">
          <joint name="Right_Hip_Roll" pos="0 0 0" axis="1 0 0" range="-1.57 0.4"
                 armature="0.0339552" damping="1" frictionloss="0.2" actuatorfrcrange="-50 50"/>
          <inertial pos="0.023585 4.9e-05 -0.024996" quat="0.677218 0.203412 0.203412 0.677218" mass="0.13" diaginertia="0.000262 0.000222694 0.000118306"/>
          <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Right_Hip_Roll"/>
          <geom size="0.036 0.047" quat="0.707105 0 0.707108 0" type="cylinder" class="visual" rgba="0.75294 0.75294 0.75294 1"/>
          <body name="Right_Hip_Yaw" pos="0.012 0 -0.0485">
            <joint name="Right_Hip_Yaw" pos="0 0 0" axis="0 0 1" range="-1 1"
                   armature="0.0282528" damping="1" frictionloss="0.2" actuatorfrcrange="-30 30"/>
            <inertial pos="-0.008475 0.0040392 -0.087906" quat="0.510308 -0.0582713 -0.00590801 0.857995" mass="1.65" diaginertia="0.0162716 0.0158564 0.00134895"/>
            <geom type="mesh" class="visual" rgba="0.75294 0.75294 0.75294 1" mesh="Right_Hip_Yaw"/>
            <geom size="0.04 0.033" pos="0 0 -0.03" type="cylinder" class="visual" rgba="0.75294 0.75294 0.75294 1"/>
            <body name="Right_Shank" pos="-0.014 0 -0.117">
              <joint name="Right_Knee_Pitch" pos="0 0 0" axis="0 1 0" range="0 2.23"
